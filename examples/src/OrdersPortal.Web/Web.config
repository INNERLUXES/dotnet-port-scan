<?xml version="1.0" encoding="utf-8"?>
<!-- Made-up settings. Addresses use the reserved example.test domain. -->
<configuration>
  <appSettings>
    <add key="OrdersPageSize" value="25" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
    <httpModules>
      <add name="OrdersAuditModule" type="OrdersPortal.Web.Modules.AuditModule, OrdersPortal.Web" />
    </httpModules>
  </system.web>
  <system.webServer>
    <modules>
      <add name="OrdersAuditModule" type="OrdersPortal.Web.Modules.AuditModule, OrdersPortal.Web" />
    </modules>
    <handlers>
      <add name="OrderChart" path="orderchart.axd" verb="GET" type="OrdersPortal.Web.Handlers.OrderChartHandler, OrdersPortal.Web" />
    </handlers>
  </system.webServer>
  <system.serviceModel>
    <client>
      <endpoint name="OrderService" address="https://orders.example.test/OrderService.svc" binding="basicHttpBinding" contract="OrderServiceReference.IOrderService" />
    </client>
  </system.serviceModel>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Example.Json" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-12.0.0.0" newVersion="12.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Example.Logging" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.1.0.0" newVersion="4.1.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
